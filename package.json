    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "exemplo": "node --experimental-strip-types examples/basico.ts",
    "exemplo:time": "node --experimental-strip-types examples/time.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
