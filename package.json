{
  "name": "arandu",
  "version": "0.1.0",
  "description": "Orquestração de agentes de IA para funções serverless, em TypeScript. / AI agent orchestration for serverless functions, in TypeScript.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Gerson Moreira (https://github.com/headdira)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/headdira/arandu.git"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "orchestration",
    "llm",
    "typescript",
    "serverless",
    "tools",
    "mcp",
    "openai"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
